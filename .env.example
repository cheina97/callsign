# Copy to .env and fill in your values. Real environment variables
# always override values from .env. CLI flags override both.

# --- callsign-client ---
# Base URL of the ESP32 REST API (or the fake server)
ESP32_URL=http://localhost:8080
# Wi-Fi SSID where the ESP32 is reachable
WIFI_SSID=YourHomeWifi
# Set to true to skip the Wi-Fi SSID check and always report state
# (useful for the Wokwi simulation or when the Mac is on a different network)
SKIP_WIFI_CHECK=false

# --- firmware (ESP32) ---
# Wi-Fi credentials baked into the firmware at build time
# (firmware/gen_wifi_config.py generates firmware/callsign/build_config.h).
# For the Wokwi simulation use WIFI_SSID=Wokwi-GUEST and WIFI_PASSWORD=
WIFI_PASSWORD=YourWifiPassword
# Set to true if the text on your matrix reads backwards (some FC16 module
# clones are wired the other way around)
FIRMWARE_MIRROR_DISPLAY=false
# Seconds without a /status update before the display turns itself off
FIRMWARE_TIMEOUT_S=300

# --- fake-server ---
# Listen address
ADDR=:8080
